#!/bin/bash
set -euo pipefail

# subspace-unmerge — remove packages previously merged from a subspace onto the host
#
# The mirror image of subspace-merge. The split is the same:
#   subspace  -> the package manager binary and its libraries
#   host      -> the package manager config, its database, and every file removed
#
# The subspace's PM binary is executed through the subspace's own dynamic
# loader, with PATH pointed at the subspace's binaries. The filesystem root is
# never changed, so the PM reads the host's config, uses the host's database and
# removes from the host.
#
# The only thing that differs from merge is the operation. Install resolves a
# target and writes it; remove resolves an installed package and unwinds it.
# Everything that made install correct applies here identically — including the
# part that matters most for removal, which is that the host's database is the
# one consulted. Pointing the PM at the subspace's own database instead, as
# this script used to, makes removal search for packages that were never
# installed there and fail with "target not found".
#
# Usage:
#   subspace-unmerge <distro> <package>   # remove a merged package
#   subspace-unmerge --pass               # skip confirmation (declarative)
#   subspace-unmerge --no-generation      # skip the pre-remove rollback generation

if [ "$EUID" -ne 0 ]; then
    echo "Error: subspace-unmerge requires root privileges." >&2
    exit 1
fi

SUBSPACE_DIR="/subspace"
PASS=0
NO_GEN=0

SUPPORTED_DISTROS="arch debian fedora opensuse void"

usage() {
    cat <<'EOF'
Usage: subspace-unmerge [options] <distro> <package>

Remove a package previously merged from a subspace onto the host system. The
mirror of subspace-merge: the subspace supplies the package manager, the host
supplies the configuration and the database, and the removal is performed
against the host.

Commands:
  subspace-unmerge <distro> <package>   Remove one merged package

Options:
  --pass             Skip confirmation prompts (for declarative use)
  --no-generation    Do not create a rollback generation before removing.
                     Use when the caller already creates one (haliade-synchronize
                     creates a 'post-sync' generation when it finishes).
                     Also required on a non-btrfs filesystem, where chronos
                     cannot snapshot at all. Note that it removes the only
                     thing a bad removal can be undone with.

Unmerging is the inverse of an experimental operation. Prefer a native Haliade
package wherever one exists, since a merge may have replaced host files that
other packages now depend on.

Supported distros: arch, debian, fedora, opensuse, void
Musl distros (alpine) cannot be unmerged, and gentoo is not supported.
EOF
}

# Default no: an empty answer proceeds to nothing.
confirm() {
    if [ "$PASS" -eq 1 ]; then return 0; fi
    read -rp "$1 [y/N]: " answer
    [[ "$answer" =~ ^[Yy]$ ]]
}

# --- Rollback generation ---
# Removal is destructive, so a pre-remove generation is created by default.
# --no-generation suppresses it for callers that already create one themselves.
#
# Aborts on failure: continuing without a rollback point would leave the host in
# a state the user cannot get back to.

create_generation() {
    local label="$1"

    if [ "$NO_GEN" -eq 1 ]; then
        return 0
    fi

    echo "Creating pre-remove generation..."
    if ! chronos create "pre-remove $label"; then
        echo "Error: could not create rollback generation. Aborting." >&2
        echo "       On a non-btrfs filesystem this always fails — pass --no-generation" >&2
        echo "       to unmerge without a rollback point (not recommended on real systems)." >&2
        exit 1
    fi
}

# --- Package manager access ---

# Run a command from a subspace against the host root.
#
# Identical to the one in subspace-merge, and for the same reasons. The
# subspace's loader so the binary resolves its own libraries rather than the
# host's, and the subspace's bin directories first on PATH so subprocesses
# resolve to the subspace's copies — zypper uses /usr/libexec helpers and rpm
# and dpkg run scriptlet binaries, all of which would otherwise be found
# against the host and fail.
#
# cd / because the PMs assume they were started at the root of the filesystem
# they are managing, and pacman stats the package's file list as relative
# paths. Run from a home directory it finds none of them and prints a "could
# not get file information" warning for every file in the package.
#
# The filesystem root is never changed, so the PM reads the host's config and
# uses the host's database. See subspace-merge for the full note on library
# resolution and how to stage a missing library.
run_pm() {
    local root="$1"
    shift

    # The subspace's glibc loader.
    #
    # Multiarch paths are included because Debian and Ubuntu put the loader at
    # lib/x86_64-linux-gnu/ rather than lib64/.
    local ld=""
    local path
    for path in \
        "$root/lib64/ld-linux-x86-64.so.2" \
        "$root/lib/ld-linux-x86-64.so.2" \
        "$root/lib/ld-linux.so.2" \
        "$root/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2" \
        "$root/lib64/ld-linux-aarch64.so.1" \
        "$root/lib/ld-linux-aarch64.so.1" \
        "$root/lib/aarch64-linux-gnu/ld-linux-aarch64.so.1"; do
        # -L rejects the absolute symlinks distros use to point at their
        # loader. Such a link reads "/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2"
        # — a path that resolves against the HOST root, not the subspace, and
        # on Haliade does not exist. So -x is false for all of them, no loader
        # is found, and the fallback below runs the binary with the host's own
        # loader instead — silently defeating the entire mechanism. The real
        # file is always the multiarch one, which is why it is checked directly.
        if [ -x "$path" ] && [ ! -L "$path" ]; then
            ld="$path"
            break
        fi
    done

    # Subspace binaries first, so subprocesses find the subspace's copies.
    local subspace_path="$root/usr/bin:$root/usr/sbin:$root/sbin:$root/bin"

    if [ -n "$ld" ]; then
        cd / || return 1
        PATH="$subspace_path:$PATH" \
        HOME="${HOME:-/root}" \
        "$ld" \
            --library-path "$root/usr/lib64:$root/usr/lib:$root/usr/lib/x86_64-linux-gnu:$root/lib64:$root/lib" \
            "$@"
    else
        # No loader found. The binary may be static, or may be missing
        # libraries. Run it anyway and let it report what is wrong — a
        # "cannot open shared object file" error names the exact library to
        # stage, which is far more useful than a silent skip.
        #
        # Note this is a plain "$@" and deliberately not "exec": this function
        # is called in a loop, and exec would replace the whole script.
        cd / || return 1
        PATH="$subspace_path:$PATH" \
        HOME="${HOME:-/root}" \
        "$@"
    fi
}

# Remove one package from the host. Returns the package manager's status.
#
# The operation is the only thing that differs from pm_install, and the same
# reasoning applies in reverse: no repository or configuration overrides are
# passed, so the PM reads the host's own config, which is where merge recorded
# what it did.
#
# There is deliberately no metadata refresh either, unlike the -Sy that
# install needs. Removal resolves entirely from the local database, so
# requiring the repositories would make unmerge fail on a host that is offline
# or whose mirror is unreachable — the worst possible time to be unable to
# undo something.
#
# Removal is bare rather than recursive on the two distros that offer a
# recursive option. pacman's -Rns and xbps' -R also drop dependencies that
# nothing else requires, and which dependencies those are is computed entirely
# from the local database — which on a merged host is a seed claiming the base
# set is installed when its files are not. That is the part of the decision
# that most trusts a fiction, and the part that can remove packages nobody
# asked to remove. So each distro removes exactly what was named:
#   arch      pacman -R     (not -Rns)
#   void      xbps-remove   (no -R)
# The others have no recursive option for this and remove only the named
# package already. Orphaned dependencies are left in place; merge them
# explicitly if they are wanted, which leaves the database honest.
pm_remove() {
    local distro="$1"
    local pkg="$2"
    local root="$SUBSPACE_DIR/$distro"

    case "$distro" in
        arch)     run_pm "$root" "$root/usr/bin/pacman" --noconfirm -R "$pkg" ;;
        debian)   run_pm "$root" "$root/usr/bin/apt-get" -y remove "$pkg" ;;
        fedora)   run_pm "$root" "$root/usr/bin/dnf" remove -y "$pkg" ;;
        opensuse) run_pm "$root" "$root/usr/bin/zypper" rm -y "$pkg" ;;
        void)     run_pm "$root" "$root/usr/bin/xbps-remove" -y "$pkg" ;;
        *) return 1 ;;
    esac
}

# Restore host identity after a transaction that rewrote it.
#
# Removing fedora-release, arch's filesystem and glibc, or openSUSE's branding-*
# has the same effect as installing them: /etc/os-release gets rewritten. A
# wrong ID changes what software on the host thinks it is running on. Mirrors
# pm_postinstall in subspace-merge.
pm_postremove() {
    local distro="$1"

    case "$distro" in
        fedora|arch|opensuse) ;;
        *) return 0 ;;
    esac

    # Idempotent: only writes if the identity is actually wrong. See
    # restore_host_identity in subspace-merge, which this mirrors — the
    # condition and the copy are deliberately identical so the two cannot
    # drift apart again the way the PRETTY_NAME did.
    if [ -f /etc/os-release ] && grep -qx 'ID=haliade' /etc/os-release; then
        return 0
    fi

    # Must match haliade-root/etc/os-release.
    cat > /etc/os-release <<'EOF'
NAME="Haliade OS"
PRETTY_NAME="Haliade OS"
ID=haliade
VERSION_CODENAME=savonius
VERSION="1.0"
HOME_URL="https://github.com/gretagen/HaliadeOS"
LOGO=haliade
EOF
}

# --- Validate distro ---
# Mirrors subspace-merge. gentoo is refused here rather than accepted and
# then rejected later: it used to be accepted by this validator while its
# package manager branch did not exist, so it failed with a misleading
# "unsupported distro" message and a help line naming a distro that is not
# supported. void was accepted here with no branch at all, and hit the same
# dead end.

validate_distro() {
    local distro="$1"
    case " $SUPPORTED_DISTROS " in
        *" $distro "*) return 0 ;;
    esac
    case "$distro" in
        alpine)
            echo "Error: cannot unmerge '$distro' — musl distro incompatible with glibc host." >&2
            exit 1
            ;;
        gentoo)
            echo "Error: cannot unmerge 'gentoo' — requires a portage tree and source compilation." >&2
            exit 1
            ;;
        *)
            echo "Error: unknown distro '$distro'." >&2
            echo "Supported: $SUPPORTED_DISTROS" >&2
            exit 1
            ;;
    esac
}

# --- Remove a merged package ---

cmd_remove() {
    local distro="$1"
    local pkg="$2"

    validate_distro "$distro"

    if [ ! -d "$SUBSPACE_DIR/$distro/usr" ]; then
        echo "Error: '$distro' subspace not installed." >&2
        exit 1
    fi

    if ! confirm "Remove $pkg from host (via $distro)?"; then
        echo "Cancelled."
        exit 0
    fi

    # Created after confirmation and before any change, so a declined prompt
    # leaves no stray generation behind and a taken generation always
    # precedes the removal.
    create_generation "$distro $pkg"

    echo "Removing $pkg from host (via $distro)..."
    echo ""

    if pm_remove "$distro" "$pkg"; then
        pm_postremove "$distro"
        manifest_remove "$distro" "$pkg"
        echo ""
        echo "Done: $pkg removed."
        run_post_merge_hooks
    else
        echo ""
        if [ "$NO_GEN" -eq 1 ]; then
            echo "Remove failed. No rollback generation was created (--no-generation)." >&2
        else
            echo "Remove failed. To revert, run: chronos rollback" >&2
        fi
        exit 1
    fi
}

# --- Manifest management ---

MANIFEST_DIR="/var/db"

# Remove a package from the merged manifest.
#
# There is deliberately no manifest_add here. Addition belongs to
# subspace-merge, which records a package only once its transaction actually
# succeeded. Two owners appending to one file would be a race, and a manifest
# listing a package that was never installed is worse than no manifest.

manifest_remove() {
    local distro="$1"
    local pkg="$2"
    local manifest="$MANIFEST_DIR/merged-$distro"

    if [ -f "$manifest" ]; then
        grep -v "^${pkg}$" "$manifest" > "$manifest.tmp" 2>/dev/null || true
        mv "$manifest.tmp" "$manifest"
    fi
}

# --- Post-merge hooks ---
# Mirrors subspace-merge. Removing a desktop application has to refresh the
# desktop, icon, MIME, font and schema caches for the same reason installing
# one does, otherwise the entry lingers after the files behind it are gone.

run_post_merge_hooks() {
    echo "Running post-merge system updates..."

    # Must come first: libraries left behind by a removal have to leave the
    # linker cache too, not just the ones added by an install.
    if command -v ldconfig &>/dev/null; then
        echo "  ldconfig"
        ldconfig >/dev/null 2>&1 || true
    fi

    if command -v update-desktop-database &>/dev/null; then
        echo "  update-desktop-database"
        update-desktop-database -q /usr/share/applications 2>/dev/null || true
        local home_dir
        for home_dir in /home/*/; do
            [ -d "${home_dir}.local/share/applications" ] && \
                update-desktop-database -q "${home_dir}.local/share/applications" 2>/dev/null || true
        done
    fi

    if command -v gtk-update-icon-cache &>/dev/null; then
        echo "  gtk-update-icon-cache"
        gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
        gtk-update-icon-cache -f -t /usr/share/icons/gnome 2>/dev/null || true
    elif command -v gtk-update-icon-cache-3.0 &>/dev/null; then
        echo "  gtk-update-icon-cache-3.0"
        gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
    fi

    if command -v update-mime-database &>/dev/null; then
        echo "  update-mime-database"
        update-mime-database /usr/share/mime 2>/dev/null || true
    fi

    if command -v fc-cache &>/dev/null; then
        echo "  fc-cache"
        fc-cache -f 2>/dev/null || true
    fi

    if command -v glib-compile-schemas &>/dev/null && [ -d /usr/share/glib-2.0/schemas ]; then
        echo "  glib-compile-schemas"
        glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true
    fi

    echo "Post-merge hooks complete."
}

# --- Main ---

# Reject anything unrecognised before doing any work. A typo in a safety flag
# must be an error, not a silently discarded argument.
for arg in "$@"; do
    case "$arg" in
        --pass|--no-generation|--help|-h) ;;
        -*)
            echo "Error: unknown option '$arg'" >&2
            usage
            exit 1
            ;;
    esac
done

# Parse flags from anywhere in args, then strip them so the positional parser
# below never sees them. Two passes because a flag may appear before or after
# the positional arguments, and --no-generation after <distro> <package> is the
# form the declarative caller and the documentation both use.
for arg in "$@"; do
    case "$arg" in
        --pass) PASS=1 ;;
        --no-generation) NO_GEN=1 ;;
    esac
done
ARGS=()
for arg in "$@"; do
    case "$arg" in
        --pass|--no-generation) ;;
        *) ARGS+=("$arg") ;;
    esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

if [ $# -lt 2 ]; then
    usage
    exit 0
fi

case "$1" in
    --help|-h)
        usage
        ;;
    -*)
        echo "Error: unknown option '$1'" >&2
        usage
        exit 1
        ;;
    *)
        distro="$1"
        pkg="$2"
        shift 2
        if [ $# -gt 0 ]; then
            echo "Error: unexpected extra arguments: $*" >&2
            usage
            exit 1
        fi
        cmd_remove "$distro" "$pkg"
        ;;
esac
