#!/bin/bash
set -euo pipefail

SUBSPACE_DIR="/subspace"


if [ "$EUID" -ne 0 ]; then
    echo "Entering a subspace requires superuser privileges."
    exit 1
fi


if [ $# -lt 1 ]; then
    echo "Usage: subspace-enter <subspace> [shell]" >&2
    echo "" >&2
    echo "Available subspaces:" >&2
    for d in "$SUBSPACE_DIR"/*/; do
        [ -d "$d/usr" ] && echo "  $(basename "$d")" >&2
    done
    exit 1
fi

subspace="$1"
root="$SUBSPACE_DIR/$subspace"

if [ ! -d "$root" ]; then
    echo "Error: Subspace '$subspace' not found at $root" >&2
    exit 1
fi

if [ $# -ge 2 ]; then
    shell="$2"
else
    for sh in /bin/bash /bin/sh /usr/bin/bash /usr/bin/sh /sbin/sh /bin/ash /usr/bin/ash; do
        if [ -L "$root/$sh" ] || [ -x "$root/$sh" ]; then
            shell="$sh"
            break
        fi
    done

    # Fallback for a rootfs where none of the FHS shells materialised — a
    # NixOS tarball extracted without activation has no /bin/sh yet. The
    # store's bash is a real directory tree on disk, so unlike profile links
    # (whose absolute in-jail targets cannot be stat'd from the host — see
    # subspace-run) it can be tested here; the path handed to subspace-run is
    # the same store path, resolved in-jail.
    if [ -z "${shell:-}" ]; then
        for cand in "$root"/nix/store/*-bash-*/bin/bash "$root"/nix/store/*-bash-*/bin/sh; do
            if [ -x "$cand" ]; then
                shell="${cand#"$root"}"
                break
            fi
        done
    fi
fi

if [ -z "${shell:-}" ]; then
    echo "Error: No shell found in $subspace" >&2
    exit 1
fi

exec "$SUBSPACE_DIR/subspace-run" "$subspace" "$shell"
