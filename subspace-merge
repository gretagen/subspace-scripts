#!/bin/bash
set -euo pipefail

# subspace-merge — merge packages from subspaces onto the host system
#
# The split is:
#   subspace  -> the package manager binary and its libraries
#   host      -> the package manager config, its database, and every file written
#
# The subspace's PM binary is executed through the subspace's own dynamic
# loader, with PATH pointed at the subspace's binaries so scriptlets and helper
# binaries resolve to the subspace's copies too. But the filesystem root is
# never changed, so the PM reads the host's config, uses the host's database and
# writes to the host. That is what makes a merge behave as though it were
# happening natively rather than as a copy of files — .desktop files, icons,
# MIME data and gschemas all land at real paths and ldconfig can see them.
#
# Usage:
#   subspace-merge <distro>                # merge all declared packages
#   subspace-merge <distro> <package>      # merge a specific package
#   subspace-merge --list                  # list all merged packages
#   subspace-merge --list <distro>         # list merged packages for a distro
#   subspace-merge --pass                  # skip confirmation prompts (declarative)
#   subspace-merge --no-generation         # skip the pre-merge rollback generation

if [ "$EUID" -ne 0 ]; then
    echo "Merging packages from subspaced distros requires superuser privileges." >&2
    exit 1
fi

SUBSPACE_DIR="/subspace"
PASS=0
NO_GEN=0

SUPPORTED_DISTROS="arch debian fedora opensuse void"

usage() {
    cat <<'EOF'
Usage: subspace-merge [options] <distro> [package]

Merge packages from a subspace onto the host system using the distro's native
package manager, running against the host root.

Commands:
  subspace-merge <distro>                Merge all declared merged-<distro> packages
  subspace-merge <distro> <package>      Merge a specific package
  subspace-merge --list                  List all merged packages across all distros
  subspace-merge --list <distro>         List merged packages for a specific distro

Options:
  --pass             Skip confirmation prompts (for declarative use)
  --no-generation    Do not create a rollback generation before merging.
                     Use when the caller already creates one (haliade-synchronize
                     creates a 'post-sync' generation when it finishes).
                     Also required on a non-btrfs filesystem, where chronos
                     cannot snapshot at all. Note that it removes the only
                     thing a bad merge can be undone with.

Merging is optional and experimental. Prefer a native Haliade package wherever
one exists. A merge can replace host files and break the system, so
overwriting existing files is permitted and a rollback generation is taken
first unless --no-generation is given.

Supported distros: arch, debian, fedora, opensuse, void
Musl distros (alpine) cannot be merged.
EOF
}

confirm() {
    if [ "$PASS" -eq 1 ]; then return 0; fi
    read -rp "$1 [y/N]: " answer
    [[ "$answer" =~ ^[Yy]$ ]]
}

# --- Rollback generation ---
# A pre-merge generation is created by default so a bad merge can be reverted
# with `chronos rollback`. --no-generation suppresses it for callers that
# already create one themselves (haliade-synchronize makes a 'post-sync'
# generation when it finishes, so per-package generations would be noise).
#
# Aborts on failure: continuing without a rollback point would leave the host
# in a state the user cannot get back to.

create_generation() {
    local label="$1"

    if [ "$NO_GEN" -eq 1 ]; then
        return 0
    fi

    echo "Creating pre-merge generation..."
    if ! chronos create "pre-merge $label"; then
        echo "Error: could not create rollback generation. Aborting." >&2
        exit 1
    fi
}

# --- Package manager access ---

# Run a command from a subspace against the host root.
#
# The subspace's dynamic loader is used so the binary resolves its own
# libraries rather than the host's. Everything else about the host is left
# alone: no chroot, no bind mount, no private library directory.
#
# PATH is prepended with the subspace's bin directories. This matters more than
# it looks: dnf5 spawns python3, zypper uses /usr/libexec helpers, and rpm and
# dpkg run scriptlet binaries. Without this they would all resolve against the
# host and fail, even when the main binary's libraries are all present.
#
# Library resolution, measured with LD_DEBUG=libs: the subspace's directories
# are searched first, and the host's /etc/ld.so.cache plus /lib and /usr/lib are
# still searched afterwards. So a subspace library wins when present, and the
# host's is the fallback. Two consequences worth knowing when staging libraries:
#
#   - A soname the host lacks entirely produces a clean, actionable error
#     ("error while loading shared libraries: libalpm.so.13") that names exactly
#     what to copy across. This is the common case while staging.
#   - A soname the host has at a *different version* does not error. The host's
#     copy is used and you get a symbol lookup failure or a crash at runtime
#     instead, which is much harder to trace back to a merge.
#
# There is no way to make the subspace authoritative without a chroot, since
# ld.so always falls back to the built-in defaults. Precedence is the best
# available and is the desirable one: the subspace's versions are preferred.
#
# The working directory is changed to / before invoking the PM. The PMs assume
# they were started at the root of the filesystem they are managing, and pacman
# in particular stats the package's file list as relative paths. Run from a
# home directory it cannot find any of them, and prints a "could not get file
# information" warning for every single file in the package.
run_pm() {
    local root="$1"
    shift

    # The subspace's glibc loader.
    #
    # Multiarch paths are included because Debian and Ubuntu put the loader at
    # lib/x86_64-linux-gnu/ rather than lib64/.
    local ld=""
    local path
    for path in \
        "$root/lib64/ld-linux-x86-64.so.2" \
        "$root/lib/ld-linux-x86-64.so.2" \
        "$root/lib/ld-linux.so.2" \
        "$root/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2" \
        "$root/lib64/ld-linux-aarch64.so.1" \
        "$root/lib/ld-linux-aarch64.so.1" \
        "$root/lib/aarch64-linux-gnu/ld-linux-aarch64.so.1"; do
        # -L rejects the absolute symlinks distros use to point at their
        # loader. Such a link reads "/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2"
        # — a path that resolves against the HOST root, not the subspace, and
        # on Haliade does not exist. So -x is false for all of them, no loader
        # is found, and the fallback below runs the binary with the host's own
        # loader instead — silently defeating the entire mechanism. The real
        # file is always the multiarch one, which is why it is checked directly.
        if [ -x "$path" ] && [ ! -L "$path" ]; then
            ld="$path"
            break
        fi
    done

    # Subspace binaries first, so subprocesses find the subspace's copies.
    local subspace_path="$root/usr/bin:$root/usr/sbin:$root/sbin:$root/bin"

    # The host's own library directories, and the subspace's, in that order.
    #
    # --library-path applies to exactly one process: the loader invocation
    # below. It is not inherited. Everything the package manager goes on to
    # exec — gpg, and every coreutil reached through the subspace PATH — is a
    # plain execve that resolves against the host's loader with no help at all.
    # That is not hypothetical: with the subspace's bin dirs on PATH, the
    # fedora and opensuse `sed` both resolve to the subspace's copy, and both
    # need libselinux.so.1, which Haliade does not have, so any pipeline the
    # script runs dies with "error while loading shared libraries". Arch escaped
    # this only because its sed needs just libattr and libc, which the host
    # happens to have — a coincidence of that distro, not a property of the
    # design. The void package manager fails the same way through gpg, which
    # needs libz, which Haliade also lacks.
    #
    # LD_LIBRARY_PATH is inherited, so it is what actually reaches those
    # descendants.
    #
    # Host first, subspace second, and the order is load-bearing in the
    # dangerous direction. Putting the subspace first would put *its* glibc on
    # the host loader's search path for every host binary too, so merging
    # void's libc.so.6 would immediately start diverting Haliade's own
    # processes onto void's C library. That is the precise catastrophe this
    # whole mechanism exists to prevent, and it would be introduced by the
    # variable meant to prevent its cousin. Host first means host binaries
    # always find the host's libraries and only genuinely-missing ones — the
    # subspace's libselinux, its libz — are filled in from the subspace.
    local host_libs="/lib64:/lib:/usr/lib64:/usr/lib"
    local subspace_libs="$root/usr/lib64:$root/usr/lib:$root/usr/lib/x86_64-linux-gnu:$root/lib64:$root/lib"
    local lib_path="$host_libs:$subspace_libs"

    if [ -n "$ld" ]; then
        cd / || return 1
        PATH="$subspace_path:$PATH" \
        LD_LIBRARY_PATH="$lib_path" \
        HOME="${HOME:-/root}" \
        "$ld" \
            --library-path "$subspace_libs" \
            "$@"
    else
        # No loader found. The binary may be static, or may be missing
        # libraries. Run it anyway and let it report what is wrong — a
        # "cannot open shared object file" error names the exact library to
        # stage, which is far more useful than a silent skip.
        #
        # Note this is a plain "$@" and deliberately not "exec": this function
        # is called in a loop, and exec would replace the whole script.
        cd / || return 1
        PATH="$subspace_path:$PATH" \
        LD_LIBRARY_PATH="$lib_path" \
        HOME="${HOME:-/root}" \
        "$@"
    fi
}

# Install one package onto the host. Returns the package manager's status.
#
# Repository and configuration overrides are deliberately absent: the PM reads
# the host's own config, which already points at the right repositories.
#
# Overwriting is allowed unconditionally, and not only for the files the host
# needs. A merged host has two package systems claiming the same paths, so
# file conflicts are structural rather than exceptional. Three quarters of a
# typical conflict list is pre-existing directories that the merged packages
# merely add files into, and much of the rest are files no host package claims
# at all — which is a conflict precisely because nothing claims them.
#
# The bound on this is worth knowing: overwriting only ever replaces files the
# package being installed actually ships. Host files outside that set are left
# alone, so this cannot replace the host userland wholesale.
#
# The real safety net is the rollback generation taken beforehand, not this
# flag. On btrfs a bad merge is reverted with `chronos rollback`; on a non-btrfs
# filesystem with --no-generation there is nothing behind it, which is why
# merging is experimental and why the generation is not optional there.
#
# --force-overwrite / --allowerasing / --force-resolution are the same idea in
# each PM's own vocabulary. The host has its own files at these paths, and a
# transaction that refuses to replace them is exactly the case merging exists
# to handle.
# Download one package from the repositories without installing it, and print
# the path of the file it fetched.
#
# This exists because four of the five package managers have no flag that means
# "install this and resolve nothing", and without that ability they drag the
# distro's base set in behind the package. Measured on the same package against
# an empty database:
#
#   arch    pacman -dd htop    ->  1 package
#   fedora  dnf5 install htop  -> 24 packages: glibc-common, glibc-minimal-langpack,
#                                 glibc-gconv-extra, setup, systemd-libs,
#                                 ncurses-base, libgcc, pam-libs, ...
#   void    xbps-install htop  ->  4 packages: glibc-2.41, ncurses-libs, ...
#
# Only pacman has the flag. So for the others the transaction is split in two:
# the resolver is allowed to do what it likes, but its output is only ever
# *downloaded*; the install is then performed by the low-level installer, which
# takes a file and resolves nothing.
#
# The resolver's choice of what to download is deliberately ignored. It fetches
# the whole dependency closure, all of which lands in the cache, and the install
# step names exactly one file out of it. The extra downloads are wasted
# bandwidth and nothing else.
#
# Prints nothing and fails if the package cannot be found or fetched.
pm_fetch() {
    local distro="$1"
    local pkg="$2"
    local root="$SUBSPACE_DIR/$distro"
    local cache

    case "$distro" in
        # --download-only writes into /var/cache/apt/archives, which is the path
        # the host already has. The alternative, `apt-get download`, writes into
        # the working directory, and run_pm is required to cd / so that the
        # package manager believes it is operating on the host root — dropping a
        # .deb in / to satisfy that is not an acceptable trade.
        debian)
            run_pm "$root" "$root/usr/bin/apt-get" -y --no-install-recommends \
                -o Dpkg::Options::=--force-overwrite \
                -o Dir::Cache::archives=/var/cache/apt/archives \
                install --download-only "$pkg" >/dev/null 2>&1 || return 1
            cache=/var/cache/apt/archives
            ;;
        fedora)
            # Two fedora-specific arguments, both forced by Haliade's identity
            # rather than by anything about fedora.
            #
            # --releasever: the repository files are written in terms of
            # $releasever, and dnf normally takes that from the host's
            # os-release. Haliade's os-release deliberately carries no
            # VERSION_ID — it is Haliade, not a Fedora derivative — so $releasever
            # resolves to nothing and every repo 404s. Naming the version
            # explicitly is the only way to read a fedora mirror from a host
            # that is not fedora.
            #
            # --disable-repo=updates: the host's updates repository points at
            # the path fedora used when 44 shipped, which no longer serves
            # repodata. The main repository is enough to resolve any package,
            # and a repository that cannot be read should not fail the merge.
            #
            # dnf5 rather than dnf: on current fedora `dnf` is a shim for dnf5,
            # and calling the shim adds a layer that can pick up a different
            # plugin set.
            # --downloadonly goes after the install subcommand: dnf5 rejects it
            # as a global option, and says so with an "Unknown argument" that
            # still exits 0, so a misplaced flag fails quietly rather than
            # loudly.
            run_pm "$root" "$root/usr/bin/dnf5" -y \
                --releasever=44 --disable-repo=updates \
                install --downloadonly "$pkg" \
                >/dev/null 2>&1 || return 1
            cache=/var/cache/libdnf5
            ;;
        opensuse)
            run_pm "$root" "$root/usr/bin/zypper" --non-interactive \
                --download-only install "$pkg" >/dev/null 2>&1 || return 1
            cache=/var/cache/zypp
            ;;
        *) return 1 ;;
    esac

    # The resolver may have fetched a different version than requested, and on
    # rpm distros the name alone does not identify the file (htop ships as
    # htop-3.4.1-3.fc44.x86_64.rpm). Match on the leading name component so a
    # request for "htop" cannot pick up "htop-vim" or a dependency that happens
    # to share the prefix.
    find "$cache" \( -name "${pkg}-*.rpm" -o -name "${pkg}_*.deb" \) 2>/dev/null |
        sort | tail -1
}

# Install one already-downloaded package file, resolving no dependencies.
#
# --nodeps (rpm) and --force-depends (dpkg) are the load-bearing flags, and each
# is the real thing rather than a weaker neighbour — the same distinction that
# makes pacman's -dd necessary rather than -d. Without them, installing a single
# file still consults the database, finds every dependency unsatisfied, and pulls
# the closure back in from the repositories.
#
# --noscripts on rpm, and no equivalent on dpkg, is a real limitation rather than
# a choice: a merged package's maintainer scripts run against a host that does
# not have the distribution they were written for. htop and the libraries this
# mechanism is used for have none.
pm_install_file() {
    local distro="$1"
    local file="$2"
    local root="$SUBSPACE_DIR/$distro"

    case "$distro" in
        fedora|opensuse)
            run_pm "$root" "$root/usr/bin/rpm" -i --nodeps --replacepkgs \
                --noscripts "$file"
            ;;
        debian)
            run_pm "$root" "$root/usr/bin/dpkg" -i --force-depends \
                --force-overwrite "$file"
            ;;
        *) return 1 ;;
    esac
}

pm_install() {
    local distro="$1"
    local pkg="$2"
    local root="$SUBSPACE_DIR/$distro"
    local file

    case "$distro" in
        # -Sy and not -Syu, deliberately. Upgrading would pull the distro's
        # entire base set — glibc, coreutils, filesystem — down onto the host
        # and overwrite the userland that Haliade is built from. A partial
        # upgrade is the point: refresh the metadata so the target resolves,
        # then change nothing but the package that was asked for.
        #
        # -y is required independently of --noconfirm: an empty database has no
        # sync metadata at all, and without it the PM reports "database file
        # for 'core' does not exist" and then "target not found" for the
        # package it was asked to install.
        #
        # -dd is the load-bearing flag, and the reason the database is allowed
        # to exist at all: it installs exactly the package named and resolves
        # nothing.
        #
        # It has to be -dd and not -d. `pacman -S --help` describes -d as
        # "skip dependency version checks (-dd to skip all checks)", which is
        # not a weaker spelling of the same idea — -d suppresses *checks* and
        # still resolves and installs the entire dependency tree. Measured
        # against an empty database with `pacman -Sp`:
        #
        #   -d  htop  ->  51 packages (glibc, bash, filesystem, ncurses, ...)
        #   -dd htop  ->   1 package  (htop)
        #
        # So the single character between them is the difference between merging
        # one package and replacing the host userland with arch's. This bit a
        # live test once already: -d queued 157 MB of arch's base set aimed at
        # /usr/bin, /usr/lib and /etc, and only two stray directory conflicts
        # stopped it from committing.
        #
        # The database is empty by design rather than seeded, and -dd is what
        # makes that safe. A seed claiming arch's base set is installed is a
        # lie — none of those files are on the host — so every base library
        # goes missing at runtime. An empty database instead invites the
        # resolver to satisfy every dependency from the repos, which is the
        # 51-package outcome above. -dd removes the question: nothing is
        # resolved, so the database's emptiness is never consulted.
        #
        # The result is a database containing only packages that were really
        # merged, each with a real file list. A truthful record rather than an
        # oracle, which is the whole point: it claims nothing untrue about the
        # system, so `pacman -Qq` is the merge history and anything reading the
        # database sees reality.
        #
        # The cost is that dependencies are not pulled in. A merged binary
        # fails with "error while loading shared libraries: libX.so.N" for each
        # one, and each is fixed by merging that library by name. This
        # converges because every failure names the exact soname to merge.
        arch)     run_pm "$root" "$root/usr/bin/pacman" --noconfirm -Sy -dd \
                          --overwrite '*' "$pkg" ;;
        # The other three have no equivalent of -dd, so they go through the
        # two-phase path: let the resolver download whatever it wants, then
        # install exactly one file with an installer that resolves nothing.
        # Verified end to end on fedora and debian; see pm_fetch and
        # pm_install_file for what each flag does and does not do.
        debian|fedora|opensuse)
            file=$(pm_fetch "$distro" "$pkg")
            [ -n "$file" ] || return 1
            pm_install_file "$distro" "$file"
            ;;
        # -f permits replacing existing files. -r / is the root, and -Sy is a
        # metadata refresh, matching the -y above.
        #
        # Unlike the three above, void has nowhere to send this. xbps-install
        # has no nodeps flag, no equivalent in xbps-uhelper (which offers only
        # metadata queries and a fetch action), and does not accept a local
        # package file — it resolves the name against the repository pool and
        # reports "not found in repository pool" for a path. There is no way to
        # ask it for one package. The line is left as-is because it is the only
        # thing xbps can do, and it is known to fetch glibc; see
        # validate_distro for the warning that says so.
        void)     run_pm "$root" "$root/usr/bin/xbps-install" -r / -Sy -f "$pkg" ;;
        *) return 1 ;;
    esac
}

# Restore host identity after a transaction that rewrote it.
#
# Several distros ship a package that owns /etc/os-release: fedora-release,
# arch's filesystem and glibc, openSUSE's branding-*. Any of those merged in
# will overwrite the host's identity, so it is put back afterwards. Cheap
# insurance, since a wrong ID can change what software on the host thinks it is
# running on.
#
# Shared by subspace-unmerge, which needs it for the same reason: removing one
# of those packages rewrites os-release just as installing it does.

restore_host_identity() {
    # Only write when the identity is actually wrong.
    #
    # This used to write unconditionally, with a PRETTY_NAME that had drifted
    # from the one in the rootfs — so every successful merge silently rewrote
    # os-release even when no package had touched it, leaving the file
    # permanently one merge behind. Checking first makes this idempotent, which
    # is the only way a "restore" can be trusted to leave things alone when
    # there was nothing to restore.
    if [ -f /etc/os-release ] && grep -qx 'ID=haliade' /etc/os-release; then
        return 0
    fi

    # Restored from the shipped factory copy instead of a literal here: this
    # heredoc drifted from haliade-root/etc/os-release once already, because
    # nothing tied the two together. /usr/share/factory/ is owned by no distro
    # release package, so the very package that broke /etc/os-release cannot
    # rewrite the reference copy either.
    [ -r /usr/share/factory/os-release ] || {
        echo "Error: /usr/share/factory/os-release missing; cannot restore host identity." >&2
        return 1
    }
    cat /usr/share/factory/os-release > /etc/os-release
}

pm_postinstall() {
    local distro="$1"

    case "$distro" in
        fedora|arch|opensuse) ;;
        *) return 0 ;;
    esac

    restore_host_identity
}

# List the packages actually merged onto the host for a distro.
#
# This reads the merge manifest, never the package manager's database. The
# database is only scaffolding so the PM can resolve and record its
# transactions; its contents are not a promise about what was merged — every
# distro records dependencies in it, and the seeded-base approach used to
# populate it with each distro's base set too. The manifest, by contrast, is
# appended to only on a successful merge and rewritten only on a successful
# removal, so it is the faithful record of what is really on the host.
pm_list() {
    local distro="$1"

    cat "$MANIFEST_DIR/merged-$distro" 2>/dev/null | sort
}

# --- Validate distro ---

validate_distro() {
    local distro="$1"
    case "$distro" in
        arch|debian|fedora|opensuse|void) return 0 ;;
        alpine)
            echo "Error: cannot merge '$distro' — musl distro incompatible with glibc host." >&2
            exit 1
            ;;
        gentoo)
            echo "Error: cannot merge 'gentoo' — requires a portage tree and source compilation." >&2
            exit 1
            ;;
        nixos)
            # nixos is a valid subspace name but has no merge path: nix
            # writes to /nix/store and profile trees, never to the FHS paths
            # every other distro's merge lands files in. An "unknown distro"
            # answer would be untrue now, and a silent no-op would be worse.
            echo "Error: cannot merge 'nixos' — merging Nix packages onto the host is not implemented (sandbox only)." >&2
            exit 1
            ;;
        *)
            echo "Error: unknown distro '$distro'." >&2
            echo "Supported: arch, debian, fedora, opensuse, void" >&2
            exit 1
            ;;
    esac
}

# --- List merged packages ---

cmd_list() {
    local distro="${1:-}"

    if [ -n "$distro" ]; then
        validate_distro "$distro"
        if [ ! -d "$SUBSPACE_DIR/$distro/usr" ]; then
            echo "Error: '$distro' subspace not installed." >&2
            exit 1
        fi
        echo "Merged packages from $distro:"
        pm_list "$distro" || echo "  (none)"
    else
        echo "Merged packages across all distros:"
        for dir in "$SUBSPACE_DIR"/*/; do
            [ -d "$dir/usr" ] || continue
            local d
            d=$(basename "$dir")
            # Skip subspaces that cannot be merged (alpine, gentoo) rather
            # than aborting the whole listing on them.
            case " $SUPPORTED_DISTROS " in
                *" $d "*) ;;
                *) continue ;;
            esac
            local pkgs
            pkgs=$(pm_list "$d" 2>/dev/null || true)
            if [ -n "$pkgs" ]; then
                echo ""
                echo "  $d:"
                echo "$pkgs" | sed 's/^/    /'
            fi
        done
    fi
}

# --- Merge a single package ---

merge_package() {
    local distro="$1"
    local pkg="$2"

    echo "  Installing $pkg via $distro..."
    if pm_install "$distro" "$pkg"; then
        pm_postinstall "$distro"
        return 0
    else
        echo "  Error: failed to install $pkg from $distro." >&2
        return 1
    fi
}

# --- Merge all declared packages for a distro ---

cmd_merge_distro() {
    local distro="$1"

    validate_distro "$distro"

    if [ ! -d "$SUBSPACE_DIR/$distro/usr" ]; then
        echo "Error: '$distro' subspace not installed." >&2
        exit 1
    fi

    # Read the definition.lua to find merged-<distro> packages
    local config_path="/etc/haliade/definition.lua"
    if [ ! -f "$config_path" ]; then
        echo "Error: $config_path not found." >&2
        exit 1
    fi

    # Extract merged-<distro> packages from the Lua config
    local key="merged-${distro}"
    local pkgs
    pkgs=$(lua -e "
        local cfg = dofile('$config_path')
        local pkgs = cfg['$key']
        if pkgs then
            for _, p in ipairs(pkgs) do print(p) end
        end
    " 2>/dev/null || true)

    if [ -z "$pkgs" ]; then
        echo "No packages declared for merged-$distro."
        return 0
    fi

    if ! confirm "Merge all declared packages from $distro onto host?"; then
        echo "Cancelled."
        exit 0
    fi

    # One generation for the whole batch, not one per package.
    create_generation "$distro"

    echo "Merging packages from $distro onto host..."
    echo ""

    local count=0
    local failed=0
    while IFS= read -r pkg; do
        [ -z "$pkg" ] && continue
        if merge_package "$distro" "$pkg"; then
            manifest_add "$distro" "$pkg"
            count=$((count + 1))
        else
            failed=$((failed + 1))
        fi
    done <<< "$pkgs"

    # Refresh caches once for the whole batch, not per package.
    if [ "$count" -gt 0 ]; then
        echo ""
        run_post_merge_hooks
    fi

    echo ""
    if [ "$failed" -gt 0 ]; then
        echo "Done: $count merged, $failed failed."
        if [ "$NO_GEN" -eq 1 ]; then
            echo "Some packages failed. No rollback generation was created (--no-generation)." >&2
        else
            echo "To revert the successful merges, run: chronos rollback" >&2
        fi
        # Non-zero so a declarative caller can tell this batch did not fully
        # succeed. The individual failures were already reported above.
        exit 1
    else
        echo "Done: $count package(s) merged from $distro."
    fi
}

# --- Merge a specific package (ad-hoc) ---

cmd_merge_package() {
    local distro="$1"
    local pkg="$2"

    validate_distro "$distro"

    if [ ! -d "$SUBSPACE_DIR/$distro/usr" ]; then
        echo "Error: '$distro' subspace not installed." >&2
        exit 1
    fi

    if ! confirm "Merge $pkg from $distro onto host?"; then
        echo "Cancelled."
        exit 0
    fi

    echo "Merging $pkg from $distro onto host..."
    echo ""

    # Create pre-merge generation
    create_generation "$distro $pkg"

    if merge_package "$distro" "$pkg"; then
        echo ""
        echo "Done: $pkg merged from $distro."
        manifest_add "$distro" "$pkg"
        run_post_merge_hooks
    else
        echo ""
        if [ "$NO_GEN" -eq 1 ]; then
            echo "Merge failed. No rollback generation was created (--no-generation)." >&2
        else
            echo "Merge failed. To revert, run: chronos rollback" >&2
        fi
        exit 1
    fi
}

# --- Manifest management ---

MANIFEST_DIR="/var/db"

# Add a package to the merged manifest
manifest_add() {
    local distro="$1"
    local pkg="$2"
    local manifest="$MANIFEST_DIR/merged-$distro"

    mkdir -p "$MANIFEST_DIR"
    # Only add if not already present
    if ! grep -qx "$pkg" "$manifest" 2>/dev/null; then
        echo "$pkg" >> "$manifest"
    fi
}

# Remove a package from the merged manifest
manifest_remove() {
    local distro="$1"
    local pkg="$2"
    local manifest="$MANIFEST_DIR/merged-$distro"

    if [ -f "$manifest" ]; then
        grep -v "^${pkg}$" "$manifest" > "$manifest.tmp" 2>/dev/null || true
        mv "$manifest.tmp" "$manifest"
    fi
}

# --- Post-merge hooks ---

run_post_merge_hooks() {
    echo "Running post-merge system updates..."

    # Must come first: newly installed shared libraries have to be in the
    # linker cache before anything tries to load them.
    if command -v ldconfig &>/dev/null; then
        echo "  ldconfig"
        ldconfig >/dev/null 2>&1 || true
    fi

    if command -v update-desktop-database &>/dev/null; then
        echo "  update-desktop-database"
        update-desktop-database -q /usr/share/applications 2>/dev/null || true
        local home_dir
        for home_dir in /home/*/; do
            [ -d "${home_dir}.local/share/applications" ] && \
                update-desktop-database -q "${home_dir}.local/share/applications" 2>/dev/null || true
        done
    fi

    if command -v gtk-update-icon-cache &>/dev/null; then
        echo "  gtk-update-icon-cache"
        gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
        gtk-update-icon-cache -f -t /usr/share/icons/gnome 2>/dev/null || true
    elif command -v gtk-update-icon-cache-3.0 &>/dev/null; then
        echo "  gtk-update-icon-cache-3.0"
        gtk-update-icon-cache-3.0 -f -t /usr/share/icons/hicolor 2>/dev/null || true
    fi

    if command -v update-mime-database &>/dev/null; then
        echo "  update-mime-database"
        update-mime-database /usr/share/mime 2>/dev/null || true
    fi

    if command -v fc-cache &>/dev/null; then
        echo "  fc-cache"
        fc-cache -f 2>/dev/null || true
    fi

    if command -v glib-compile-schemas &>/dev/null && [ -d /usr/share/glib-2.0/schemas ]; then
        echo "  glib-compile-schemas"
        glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true
    fi

    echo "Post-merge hooks complete."
}

# --- Main ---

# Reject anything unrecognised before doing any work.
#
# This used to be silent, and silent is the worst available outcome: a typo in
# --no-generation fell through as a stray positional argument, was discarded
# past the package name, and the merge ran anyway. A misspelled safety flag
# must be an error, not a no-op.
for arg in "$@"; do
    case "$arg" in
        --pass|--no-generation|--list|-l|--help|-h) ;;
        -*)
            echo "Error: unknown option '$arg'" >&2
            usage
            exit 1
            ;;
    esac
done

# Parse flags from anywhere in args
for arg in "$@"; do
    case "$arg" in
        --pass) PASS=1 ;;
        --no-generation) NO_GEN=1 ;;
    esac
done
# Remove the flags from args so the rest of the parser doesn't see them
ARGS=()
for arg in "$@"; do
    case "$arg" in
        --pass|--no-generation) ;;
        *) ARGS+=("$arg") ;;
    esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

if [ $# -lt 1 ]; then
    usage
    exit 0
fi

case "$1" in
    --list|-l)
        shift
        if [ $# -gt 1 ]; then
            echo "Error: unexpected extra arguments: $*" >&2
            usage
            exit 1
        fi
        cmd_list "${1:-}"
        ;;
    --help|-h)
        usage
        ;;
    -*)
        echo "Error: unknown option '$1'" >&2
        usage
        exit 1
        ;;
    *)
        distro="$1"
        shift

        validate_distro "$distro"

        if [ $# -ge 1 ]; then
            if [ $# -gt 1 ]; then
                echo "Error: unexpected extra arguments: $*" >&2
                usage
                exit 1
            fi
            # Merge specific package
            cmd_merge_package "$distro" "$1"
        else
            # Merge all declared packages for this distro
            cmd_merge_distro "$distro"
        fi
        ;;
esac
